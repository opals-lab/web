---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// EDIT ME: nothing to list yet, so this is commented out and the page shows
// a "Coming Soon!" message instead. When there's something to publish,
// uncomment and fill in real entries — group headings (`group`) can be
// renamed/reordered/added to freely, the page just loops over them.
const groups: { group: string; items: { type: string; citation: string; link: string }[] }[] = [
  // {
  //   group: 'Publications',
  //   items: [
  //     {
  //       type: 'Journal Article',
  //       citation:
  //         'Author, A. A. (Year). Title of the article goes here. Journal Name, Volume(Issue), page range.',
  //       link: '#',
  //     },
  //     {
  //       type: 'Journal Article',
  //       citation:
  //         'Author, A. A., & Author, B. B. (Year). Title of the article goes here. Journal Name, Volume(Issue), page range.',
  //       link: '#',
  //     },
  //   ],
  // },
  // {
  //   group: 'Presentations',
  //   items: [
  //     {
  //       type: 'Conference Talk',
  //       citation:
  //         'Author, A. A. (Year, Month). Title of the talk or poster [Conference presentation]. Conference Name, City, State.',
  //       link: '#',
  //     },
  //   ],
  // },
  // {
  //   group: 'Tools & Datasets',
  //   items: [
  //     {
  //       type: 'Open Dataset',
  //       citation: 'Short description of a publicly available dataset, code repository, or tool the lab has produced.',
  //       link: '#',
  //     },
  //   ],
  // },
];
---

<BaseLayout title="Research Products" description="Publications, presentations, and tools from OPALS Lab.">
  <PageHero
    eyebrow="Research Products"
    title="Publications, talks, and tools."
    lede="A running record of what the lab has published, presented, and built."
  />

  <section class="section products">
    <div class="container">
      {groups.length === 0 ? (
        <p class="products__empty">Coming Soon!</p>
      ) : (
        groups.map((g) => (
          <div class="productGroup">
            <h2>{g.group}</h2>
            <ul class="productList">
              {g.items.map((item) => (
                <li class="productItem">
                  <span class="tag">{item.type}</span>
                  <p>{item.citation}</p>
                  <a href={item.link} class="productItem__link">View &rarr;</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .products { padding-top: 64px; }
  .products__empty {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--gray);
    text-align: center;
    padding: 40px 0;
  }
  .productGroup { margin-bottom: 56px; }
  .productGroup:last-child { margin-bottom: 0; }
  .productGroup h2 { margin-bottom: 24px; }
  .productList { display: flex; flex-direction: column; gap: 22px; }
  .productItem {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: 20px;
    align-items: start;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--teal-pale);
  }
  .productItem p { margin: 0; color: var(--charcoal); }
  .productItem__link {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--charcoal);
    white-space: nowrap;
    border-bottom: 2px solid var(--teal-dark);
    padding-bottom: 2px;
  }

  @media (max-width: 700px) {
    .productItem { grid-template-columns: 1fr; gap: 10px; }
  }
</style>

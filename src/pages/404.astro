---
import BaseLayout from '../layouts/BaseLayout.astro';
import ColorBlocks from '../components/ColorBlocks.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Return to the OPALS Lab home page.">
  <section class="section notFound">
    <div class="container notFound__inner">
      <div class="notFound__blocks" aria-hidden="true">
        <ColorBlocks variant="corner" />
      </div>
      <span class="eyebrow">404</span>
      <h1>This page doesn't exist.</h1>
      <p class="lede">The page you're looking for may have moved. Try one of the links below.</p>
      <a href="/" class="btn">Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notFound { padding: 120px 0; text-align: center; }
  .notFound__inner { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .notFound__blocks { margin-bottom: 24px; }
  .notFound h1 { margin-bottom: 10px; }
  .notFound .lede { margin-bottom: 28px; }
</style>

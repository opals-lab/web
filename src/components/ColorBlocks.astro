{variant === 'strip' && (
  <div class="blocks blocks--strip" aria-hidden="true">
    <span class="s s1"></span>
    <span class="s s2"></span>
    <span class="s s3"></span>
    <span class="s s4"></span>
    <span class="s s5"></span>
    <span class="s s6"></span>
    <span class="s s7"></span>
  </div>
)}

{variant === 'corner' && (
  <div class="blocks blocks--corner" aria-hidden="true">
    <span class="cell k1"></span>
    <span class="cell k2"></span>
    <span class="cell k3"></span>
    <span class="cell k4"></span>
  </div>
)}

<style>
  .blocks { display: grid; }

  /* ---- hero: 2 cols x 3 uneven rows, like the logo ---- */
  .blocks--hero {
    grid-template-columns: 1.1fr 1fr;
    grid-template-rows: 1.25fr 1fr 0.85fr;
    width: 100%;
    height: 100%;
    min-height: 340px;
    gap: 6px;
  }
  .blocks--hero .cell { border-radius: 1px; }
  .c1 { background: var(--teal-dark); grid-column: 1; grid-row: 1; }
  .c2 { background: var(--teal-pale); grid-column: 2; grid-row: 1; }
  .c3 { background: var(--teal-pale); grid-column: 1; grid-row: 2; }
  .c4 { background: var(--teal-mid); grid-column: 2; grid-row: 2; }
  .c5 { background: var(--teal-mid); grid-column: 1; grid-row: 3; }
  .c6 { background: var(--charcoal); grid-column: 2; grid-row: 3; }

  /* ---- scatter: loose, rotated pieces bled across a full-bleed field ---- */
  .blocks--scatter {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .blocks--scatter .d { position: absolute; border-radius: 1px; }
  .d1 {
    background: var(--teal-pale);
    width: 38vw;
    height: 60%;
    top: -12%;
    right: -8vw;
    transform: rotate(-5deg);
  }
  .d1__pin {
    position: absolute;
    top: 30%;
    right: 46%;
    width: clamp(110px, 14vw, 210px);
    height: clamp(110px, 14vw, 210px);
    fill: #d0e6e3;
    transform: rotate(5deg);
  }
  .d2 {
    background: var(--teal-mid);
    width: 15vw;
    height: 34%;
    bottom: -6%;
    right: 12vw;
    transform: rotate(4deg);
  }
  .d2__icon {
    position: absolute;
    top: 26%;
    left: 27%;
    width: clamp(72px, 7vw, 110px);
    height: clamp(72px, 7vw, 110px);
    fill: none;
    stroke: #bad9d5;
    stroke-width: 1.6;
    transform: rotate(-4deg);
  }
  .d3 {
    background: var(--teal-dark);
    width: 120px;
    height: 120px;
    bottom: 8%;
    left: -40px;
    transform: rotate(9deg);
  }
  .d3__icon {
    position: absolute;
    top: 30%;
    left: 30%;
    width: 54px;
    height: 54px;
    fill: #c7dad8;
    transform: rotate(-9deg);
  }
  .d4 {
    background: var(--teal-light);
    width: 60px;
    height: 60px;
    top: 22%;
    left: 4%;
    transform: rotate(-8deg);
  }
  .d4__icon {
    position: absolute;
    top: 18%;
    left: 18%;
    width: 40px;
    height: 40px;
    fill: #c7e6e2;
    transform: rotate(8deg);
  }
  .d5 {
    background: var(--charcoal);
    width: 90px;
    height: 14px;
    bottom: 30%;
    right: 6%;
    transform: rotate(-3deg);
  }

  @media (max-width: 1024px) {
    .d1__pin,
    .d2__icon,
    .d3__icon,
    .d4__icon {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .d1 { width: 60vw; right: -20vw; }
    .d2 { display: none; }
    .d3 { width: 80px; height: 80px; }
  }

  /* ---- strip: thin horizontal divider ---- */
  .blocks--strip {
    grid-auto-flow: column;
    grid-template-columns: 1.4fr 1fr 0.6fr 1.8fr 1fr 0.8fr 1.2fr;
    height: 8px;
    width: 100%;
  }
  .s1 { background: var(--teal-dark); }
  .s2 { background: var(--teal-pale); }
  .s3 { background: var(--teal-mid); }
  .s4 { background: var(--teal-light); }
  .s5 { background: var(--teal-pale); }
  .s6 { background: var(--teal-dark); }
  .s7 { background: var(--teal-mid); }

  /* ---- corner: small 2x2 accent ---- */
  .blocks--corner {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    width: 84px;
    height: 84px;
    gap: 4px;
  }
  .k1 { background: var(--teal-dark); }
  .k2 { background: var(--teal-mid); }
  .k3 { background: var(--teal-pale); }
  .k4 { background: var(--charcoal); }

  @media (max-width: 760px) {
    .blocks--hero { min-height: 220px; }
  }
</style>

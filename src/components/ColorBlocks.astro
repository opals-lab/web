    </span>
    <span class="d d4">
      <svg class="d4__icon" viewBox="0 -8 72 72">
        <path d="M42.92,41.88H29.08a1.87,1.87,0,1,0,0,3.73H42.92a1.87,1.87,0,1,0,0-3.73Z" />

---
// Decorative geometric motif echoing the uneven color-block grid in the OPALS
// logo (tall/medium/short rows, alternating pale teal tones + one dark cell).
// variant: "hero" (big asymmetric grid), "strip" (thin divider row), "corner"
interface Props {
  variant?: 'hero' | 'scatter' | 'strip' | 'corner';
}
const { variant = 'hero' } = Astro.props;
---

{variant === 'hero' && (
  <div class="blocks blocks--hero" aria-hidden="true">
    <span class="cell c1"></span>
    <span class="cell c2"></span>
    <span class="cell c3"></span>
    <span class="cell c4"></span>
    <span class="cell c5"></span>
    <span class="cell c6"></span>
  </div>
)}

{variant === 'scatter' && (
  <div class="blocks blocks--scatter" aria-hidden="true">
    <span class="d d1">
      <svg class="d1__pin" viewBox="0 0 512 512">
        <path d="M256,0C159.969,0,82.109,77.859,82.109,173.906c0,100.719,80.016,163.688,123.297,238.719

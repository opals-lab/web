          s66.516,29.781,66.516,66.531C322.516,210.625,292.734,240.406,256,240.406z" />
      </svg>
    </span>
    <span class="d d2">
      <svg class="d2__icon" viewBox="0 0 24 24" fill="none">
        <path d="M12.3212 10.6852L4 19L6 21M7 16L9 18M20 7.5C20 9.98528 17.9853 12 15.5 12C13.0147 12 11 9.98528 11 7.5C11 5.01472 13.0147 3 15.5 3C17.9853 3 20 5.01472 20 7.5Z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="d d3">
      <svg class="d3__icon" viewBox="0 0 256 229">
        <path d="M129.593,64.314c23.543-30.833,44.788-45.063,54.751-45.063c1.37,0,2.507,0.258,3.386,0.775

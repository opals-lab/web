---
const links = [
  { href: '/', label: 'Home' },
  { href: '/our-mission', label: 'Our Mission' },
  { href: '/our-team', label: 'Our Team' },
  { href: '/current-projects', label: 'Current Projects' },
  { href: '/research-products', label: 'Research Products' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="OPALS Lab home">
      <span class="nav__wordmark">OPALS<span class="script-accent nav__script">lab</span></span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav__link', { 'is-active': path === l.href }]}>{l.label}</a>
      ))}
      <a href="/work-with-us" class="btn nav__cta">Work With Us</a>
    </nav>

    <button id="navToggle" class="nav__toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="navMobile" class="nav__mobile" aria-label="Primary mobile">
    {links.map((l) => (
      <a href={l.href} class:list={['nav__mobileLink', { 'is-active': path === l.href }]}>{l.label}</a>
    ))}
    <a href="/work-with-us" class="nav__mobileLink nav__mobileLink--cta">Work With Us</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const mobile = document.getElementById('navMobile');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--teal-mid);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .nav__brand { text-decoration: none; }
  .nav__wordmark {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    color: var(--black);
    letter-spacing: 0.01em;
  }
  .nav__script {
    font-size: 0.95em;
    margin-left: 0.12em;
    color: var(--charcoal);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav__link {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--charcoal);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
  }
  .nav__link:hover, .nav__link.is-active {
    border-bottom-color: var(--teal-dark);
  }
  .nav__cta { padding: 0.6em 1.2em; font-size: 0.85rem; }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .nav__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--charcoal);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--teal-mid);
    background: var(--white);
  }
  .nav__mobile.is-open { display: flex; }
  .nav__mobileLink {
    font-family: var(--font-cond);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--charcoal);
    padding: 16px 28px;
    border-bottom: 1px solid var(--teal-pale);
  }
  .nav__mobileLink.is-active { background: var(--teal-pale); }
  .nav__mobileLink--cta { color: var(--white); background: var(--charcoal); }

  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__toggle { display: flex; }
  }
</style>

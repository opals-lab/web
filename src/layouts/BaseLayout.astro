---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'OPALS Lab studies Opportunity, Place, and Learning in STEM at the University of Tennessee, Knoxville.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title} · OPALS Lab</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={`${title} · OPALS Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/opals-logo-square.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      document.querySelectorAll('a[data-eu][data-ed]').forEach((el) => {
        const user = (el.getAttribute('data-eu') || '').split('').reverse().join('');
        const domain = (el.getAttribute('data-ed') || '').split('').reverse().join('');
        const subject = el.getAttribute('data-es');
        const address = `${user}@${domain}`;
        el.setAttribute('href', `mailto:${address}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`);
        if (el.getAttribute('data-has-label') === '0') el.textContent = address;
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--charcoal);
    color: var(--white);
    padding: 10px 16px;
    z-index: 200;
    font-family: var(--font-cond);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .skip-link:focus {
    left: 12px;
    top: 12px;
  }
</style>
